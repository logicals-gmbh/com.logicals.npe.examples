PROGRAM EstopDemo
  USING safety.plcopen;
  VAR
    logicals_safety_plcopen_SF_EmergencyStop1 : SF_EmergencyStop;
    Enable : BOOL;
    EstopInput : SAFEBOOL;
    logicals_safety_plcopen_SF_ESPE1 : SF_ESPE;
    LightCurtainInput : SAFEBOOL;
    SAFETRUE : SAFEBOOL := 1;
    Reset : BOOL;
    logicals_safety_plcopen_SF_OutControl1 : SF_OutControl;
    MotorLogic : BOOL;
    MotorOutput : SAFEBOOL;
  END_VAR

  (*

    // Network 1:
    logicals_safety_plcopen_SF_EmergencyStop1(Activate := Enable, S_EStopIn := EstopInput, S_StartReset := SAFETRUE, S_AutoReset := SAFETRUE, Reset := Reset);
    logicals_safety_plcopen_SF_ESPE1(Activate := Enable, S_ESPE_In := LightCurtainInput, S_StartReset := SAFETRUE, S_AutoReset := SAFETRUE, Reset := Reset);
    AND(IN1 := logicals_safety_plcopen_SF_EmergencyStop1.S_EStopOut, IN2 := logicals_safety_plcopen_SF_ESPE1.S_ESPE_Out, AND => @C(19).AND);
    logicals_safety_plcopen_SF_OutControl1(Activate := logicals_safety_plcopen_SF_EmergencyStop1.Ready, S_SafeControl := @C(19).AND, ProcessControl := MotorLogic, S_StartReset := SAFETRUE, S_AutoReset := SAFETRUE, Reset := Enable, S_OutControl => MotorOutput);

  *)

  @C(1) : @FB(logicals_safety_plcopen_SF_EmergencyStop1), @R(435.0, 150.0, 330.0, 224.0), @I(@N(Activate), @L(54.5)), @I(@N(S_EStopIn), @L(84.5)), @I(@N(S_StartReset), @L(114.5)), @I(@N(S_AutoReset), @L(144.5)), @I(@N(Reset), @L(174.5)), @O(@N(Ready), @R(54.5)), @O(@N(S_EStopOut), @R(84.5)), @O(@N(SafetyDemand), @R(114.5)), @O(@N(ResetRequest), @R(144.5)), @O(@N(Error), @R(174.5)), @O(@N(DiagCode), @R(204.5));
  @VF(2) : @E(Enable), @R(120.0, 195.0, 150.0, 19.0);
