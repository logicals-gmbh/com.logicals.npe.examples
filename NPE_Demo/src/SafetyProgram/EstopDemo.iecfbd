  @C(6) : @FB(logicals_safety_plcopen_SF_ESPE1), @R(435.0, 435.0, 330.0, 224.0), @I(@N(Activate), @L(54.5)), @I(@N(S_ESPE_In), @L(84.5)), @I(@N(S_StartReset), @L(114.5)), @I(@N(S_AutoReset), @L(144.5)), @I(@N(Reset), @L(174.5)), @O(@N(Ready), @R(54.5)), @O(@N(S_ESPE_Out), @R(84.5)), @O(@N(SafetyDemand), @R(114.5)), @O(@N(ResetRequest), @R(144.5)), @O(@N(Error), @R(174.5)), @O(@N(DiagCode), @R(204.5));
  @VF(8) : @E(LightCurtainInput), @R(135.0, 510.0, 150.0, 19.0);
  @VF(10) : @E(SAFETRUE), @R(135.0, 540.0, 150.0, 19.0);
  @VF(14) : @E(Reset), @R(135.0, 600.0, 150.0, 19.0);
  @C(17) : @FB(logicals_safety_plcopen_SF_OutControl1), @R(1275.0, 150.0, 330.0, 254.0), @I(@N(Activate), @L(54.5)), @I(@N(S_SafeControl), @L(84.5)), @I(@N(ProcessControl), @L(114.5)), @I(@N(StaticControl), @L(144.5)), @I(@N(S_StartReset), @L(174.5)), @I(@N(S_AutoReset), @L(204.5)), @I(@N(Reset), @L(234.5)), @O(@N(Ready), @R(54.5)), @O(@N(S_OutControl), @R(84.5)), @O(@N(SafetyDemand), @R(114.5)), @O(@N(ResetRequest), @R(144.5)), @O(@N(Error), @R(174.5)), @O(@N(DiagCode), @R(204.5));
  @C(19) : @F(AND), @R(915.0, 225.0, 180.0, 104.0), BOOL, @I(@N(IN1), @L(54.5)), @I(@N(IN2), @L(84.5)), @O(@N(AND), @R(54.5));
  @VF(23) : @E(MotorLogic), @R(135.0, 675.0, 150.0, 19.0);
  @VF(28) : @E(MotorOutput), @R(1695.0, 225.0, 150.0, 19.0);
  @CP(7) : 299.5, 204.5;
  @CP(12) : 404.5, 549.5;
  @CP(13) : 404.5, 294.5;
