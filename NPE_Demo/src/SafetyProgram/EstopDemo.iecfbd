  @CP(25) : 404.5, 399.5;
  @CP(26) : 1199.5, 354.5;
  @CP(27) : 299.5, 414.5;

  @G(3) :
     @L(@VF(2).o, @CP(7)),
     @L(@CP(7), @C(1).Activate),
