(* HIS Packaging Demo: hardware operation or automatic exhibition simulation.
 * SimMode defaults to FALSE. Simulation ignores the four physical inputs.
 * Only the demo inputs/commands are substituted; PLCopen blocks stay active.
 * Intended for this indicator-only demonstrator, not real actuator operation.
 *)
PROGRAM PRG_HISDemo
	VAR
		SimMode : BOOL := FALSE; (* TRUE = autonomous simulation; FALSE = physical inputs. *)
		SimInjectFaults : BOOL := TRUE; (* Jam on attempt 3, E-stop on attempt 6. *)
		SimFastCycle : BOOL := FALSE;
		SimModePrev : BOOL := FALSE;
		ModeChanged : BOOL;
		HardwareCommandsArmed : BOOL := TRUE;
		Simulation : FB_PackagingSimulation;
		DataSimulation : FB_PackagingDataSimulation;
		SimDataOutputsOwned : BOOL := FALSE;
		(* Selected E-stop input: FALSE = pressed; TRUE = released.
		 Derived every scan from hardware or the simulation block. *)
		Sim_EStopReleased : SAFEBOOL := FALSE;
		(* Derived virtual contacts, overwritten every scan; do not edit online. *)
		S_EStopA : SAFEBOOL;
		S_EStopB : SAFEBOOL;

		CmdEnable : BOOL; (* Latched enable: physical button toggles on each rising edge. *)
		EnableButtonPrev : BOOL := FALSE;
		EnableButtonFirstScan : BOOL := TRUE;
		CmdStart : BOOL;
		CmdStop : BOOL;
		CmdFastCycle : BOOL;
		CmdJam : BOOL;
		CmdSafetyReset : BOOL;
		CmdAckJam : BOOL;

		(* Symbolic outputs: actual terminals will be assigned later. *)
		S_DemoEnable : SAFEBOOL; (* Safe permission indicator; not a run command. *)
		LedReady : BOOL;
		LedConveyor : BOOL;
		LedSealing : BOOL;
		LedAttention : BOOL;

		Safety : FB_HISSafety;
		Line : FB_PackagingLine;
		Lamps : FB_PackagingIndicators;
	END_VAR

	VAR_EXTERNAL
		EStop : SAFEBOOL;
		Button1Input : BOOL;
		Button2Input : BOOL;
		Button3Input : BOOL;
		Button1Indicator : BOOL { description := "��e";
		comment := "Indicator light of first button";};
		Button2Indicator : BOOL { description := "��e";
		comment := "Indicator light of second button";};
		Button3Indicator : BOOL { description := "��e";
		comment := "Indicator light of third button";};
		O01 : BOOL;
		O02 : BOOL;
		O03 : BOOL;
		O04 : BOOL;
		O14 : BOOL;
		O15 : BOOL;
		O16 : BOOL;
		O17 : BOOL;
		O18 : BOOL;
		SO01 : SAFEBOOL;
		SO02 : SAFEBOOL;
		SO12 : SAFEBOOL;
		SO13 : SAFEBOOL;
		SO14 : SAFEBOOL;
	END_VAR

	(* Returning to hardware always requires a new enable/start action.
	   Ignore a held physical enable button during the transition. *)
	ModeChanged := SimMode <> SimModePrev;
	IF ModeChanged THEN
		CmdEnable := FALSE;
		CmdStart := FALSE;
		CmdSafetyReset := FALSE;
		CmdStop := FALSE;
		CmdFastCycle := FALSE;
		CmdJam := FALSE;
		CmdAckJam := FALSE;
		EnableButtonFirstScan := TRUE;
		HardwareCommandsArmed := FALSE;
	END_IF;

	IF SimMode THEN
		(* No physical input is read in this branch. Feedback is one scan old. *)
		Simulation(Reset := ModeChanged, Permit := Safety.S_Permit,
			LineReady := Line.Ready, LineState := Line.State, LineFault := Line.Fault,
			InjectFaults := SimInjectFaults, FastCycle := SimFastCycle);
		Sim_EStopReleased := Simulation.EStopReleased;
		CmdEnable := Simulation.Enable;
		CmdStart := Simulation.Start;
		CmdSafetyReset := Simulation.SafetyReset;
		CmdStop := Simulation.Stop;
		CmdFastCycle := Simulation.FastCycleCommand;
		CmdJam := Simulation.Jam;
		CmdAckJam := Simulation.AckJam;
	ELSE
		Sim_EStopReleased := EStop;
		(* One scan with no E-stop permit on mode exit resets the safety path.
		   Hardware reset/start buttons must also be released before reuse. *)
		IF ModeChanged THEN Sim_EStopReleased := FALSE; END_IF;
		IF Button1Input AND NOT EnableButtonPrev AND NOT EnableButtonFirstScan THEN
			CmdEnable := NOT CmdEnable;
		END_IF;
		EnableButtonPrev := Button1Input;
		EnableButtonFirstScan := FALSE;
		IF NOT ModeChanged AND NOT Button2Input AND NOT Button3Input THEN
			HardwareCommandsArmed := TRUE;
		END_IF;
		CmdSafetyReset := Button2Input AND HardwareCommandsArmed AND NOT ModeChanged;
		CmdStart := Button3Input AND HardwareCommandsArmed AND NOT ModeChanged;
	END_IF;
	SimModePrev := SimMode;

	(* Update both virtual contacts before evaluating safety. *)
	S_EStopA :=	Sim_EStopReleased;
	S_EStopB := Sim_EStopReleased;

	(* Order matters: simulated inputs -> safety -> process -> indication. *)
	Safety(S_EStopA := S_EStopA, S_EStopB := S_EStopB, Reset := CmdSafetyReset);

	(* Safety path does not depend on the standard sequence or standard lamps. *)
	S_DemoEnable := Safety.S_Permit;

	Line(Enable := CmdEnable, Permit := Safety.S_Permit, Start := CmdStart, Stop := CmdStop, FastCycle := CmdFastCycle, Jam := CmdJam, AckJam := CmdAckJam);

    IF SimMode THEN
        DataSimulation(Reset := ModeChanged, S_Permit := Safety.S_Permit,
            S_EStopReleased := Sim_EStopReleased, LineState := Line.State,
            LineFault := Line.Fault, CycleDone := Line.CycleDone,
            FastCycle := Line.FastCycleActive, Heartbeat := Line.Heartbeat);
        SimDataOutputsOwned := TRUE;
    ELSIF SimDataOutputsOwned THEN
        (* One-time mode-exit cleanup. No cyclic hardware-mode writer. *)
        O01 := FALSE;
        O02 := FALSE;
        O03 := FALSE;
        O04 := FALSE;
        O14 := FALSE;
        O15 := FALSE;
        O16 := FALSE;
        O17 := FALSE;
        O18 := FALSE;
        SO01 := FALSE;
        SO02 := FALSE;
        SO12 := FALSE;
        SO13 := FALSE;
        SO14 := FALSE;
        SimDataOutputsOwned := FALSE;
    END_IF;

	Lamps(Permit := Safety.S_Permit, Ready := Line.Ready, Infeed := Line.Infeed, Sealing := Line.Sealing, Outfeed := Line.Outfeed, Complete := Line.Complete, Blocked := Line.Blocked, ProcessFault := Line.Fault, SafetyError := Safety.Error, ResetRequest := Safety.ResetRequest, Heartbeat := Line.Heartbeat, LedReady => LedReady, LedConveyor => LedConveyor, LedSealing => LedSealing, LedAttention => LedAttention);

	Button1Indicator := Lamps.LedReady;
	Button2Indicator := Lamps.LedConveyor;
	Button3Indicator := Lamps.LedSealing;

END_PROGRAM
