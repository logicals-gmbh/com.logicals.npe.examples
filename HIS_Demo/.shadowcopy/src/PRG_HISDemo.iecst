(* RTS MAX SOFTWARE SIMULATION ONLY.
 *    Not for use with physical safety I/O or real actuators.
 *    Sim_EStopReleased drives both virtual contacts in the same scan.
 *    This replaces the hardware-oriented PRG_HISDemo for offline testing only.
 *    All other POUs remain unchanged. No simulation enable/bypass is added to
 *    FB_HISSafety or its PLCopen block instances.
 *)
PROGRAM PRG_HISDemo
	VAR
		(* FALSE = simulated emergency stop pressed; TRUE = released.
		 Write only this variable to operate the simulated two-channel device. *)
		Sim_EStopReleased : SAFEBOOL := FALSE;
		(* Derived virtual contacts, overwritten every scan; do not edit online. *)
		S_EStopA : SAFEBOOL;
		S_EStopB : SAFEBOOL;

		CmdEnable : BOOL;
		CmdStart : BOOL;
		CmdStop : BOOL;
		CmdFastCycle : BOOL;
		CmdJam : BOOL;
		CmdSafetyReset : BOOL;
		CmdAckJam : BOOL;

		(* Symbolic outputs: actual terminals will be assigned later. *)
		S_DemoEnable : SAFEBOOL; (* Safe permission indicator; not a run command. *)
		LedReady : BOOL;
		LedConveyor : BOOL;
		LedSealing : BOOL;
		LedAttention : BOOL;

		Safety : FB_HISSafety;
		Line : FB_PackagingLine;
		Lamps : FB_PackagingIndicators;
	END_VAR

	VAR_EXTERNAL
		EStop : SAFEBOOL;
		Button1Input : BOOL;
		Button2Input : BOOL;
		Button3Input : BOOL;
		Button1Indicator : BOOL { description := "��e";
		comment := "Indicator light of first button";};
		Button2Indicator : BOOL { description := "��e";
		comment := "Indicator light of second button";};
		Button3Indicator : BOOL { description := "��e";
		comment := "Indicator light of third button";};
	END_VAR

	/* Assign IO signals */
	Sim_EStopReleased := EStop;
	CmdEnable := Button1Input;
	CmdSafetyReset := Button2Input;
	CmdStart := Button3Input;

	(* Update both virtual contacts before evaluating safety. *)
	S_EStopA :=	Sim_EStopReleased;
	S_EStopB := Sim_EStopReleased;

	(* Order matters: simulated inputs -> safety -> process -> indication. *)
	Safety(S_EStopA := S_EStopA, S_EStopB := S_EStopB, Reset := CmdSafetyReset);

	(* Safety path does not depend on the standard sequence or standard lamps. *)
	S_DemoEnable := Safety.S_Permit;

	Line(Enable := CmdEnable, Permit := Safety.S_Permit, Start := CmdStart, Stop := CmdStop, FastCycle := CmdFastCycle, Jam := CmdJam, AckJam := CmdAckJam);

	Lamps(Permit := Safety.S_Permit, Ready := Line.Ready, Infeed := Line.Infeed, Sealing := Line.Sealing, Outfeed := Line.Outfeed, Complete := Line.Complete, Blocked := Line.Blocked, ProcessFault := Line.Fault, SafetyError := Safety.Error, ResetRequest := Safety.ResetRequest, Heartbeat := Line.Heartbeat, LedReady => LedReady, LedConveyor => LedConveyor, LedSealing => LedSealing, LedAttention => LedAttention);

	Button1Indicator := Lamps.LedReady;
	Button2Indicator := Lamps.LedConveyor;
	Button3Indicator := Lamps.LedSealing;

END_PROGRAM
