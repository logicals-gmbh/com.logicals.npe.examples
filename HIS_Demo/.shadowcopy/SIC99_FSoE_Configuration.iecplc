{
	TARGET RemoteTarget
		PARAMS := '{
				"transport" : {
					"type" : "TCP",
					"parameters" : {
						"ip" : "192.168.0.100",
						"port" : 2049
					}
				}
			}';
	END_TARGET
}

CONFIGURATION RemoteConfiguration
	RESOURCE SIC99_FSoE ON usRTSSIC99E { ON_TARGET := RemoteTarget, VIA_NCF }
		{ IO_IMPORT PROVIDER := GenericProvider, SERVICE := Local }
		{ IO_IMPORT PROVIDER := GenericProvider, SERVICE := FSoE }
		{ IO_IMPORT PROVIDER := GenericProvider, SERVICE := EtherCAT }

		{ IO:=Local, FSoE, EtherCAT } TASK DefaultTask (INTERVAL := TIME#500ms, PRIORITY := 38229);
		       
        PROGRAM EstopDemo WITH DefaultTask :
            EstopDemo;
            

	END_RESOURCE
END_CONFIGURATION

