<?xml version="1.0" encoding="utf-8"?>
<!-- Requirements:  -->
<!-- [#§RM-ID 700.15] (RD-ID 73.15) <D> The SCTL device catalog must define channel-functions and parameter-groups for interdependent parameters to provide a consistent safe container approval by the library.[§]  -->
<!-- [#§RM-ID 700.16] (RD-ID 73.16) <D> The SCTL device catalog must define unique identifiers for all devices, modules and parameters, to avoid ambiguous conditions in the target device when processing the binary safe container.[§]  -->
<!-- [#§RM-ID 700.29] (RD-ID 73.29) <D> The device catalog must be configured with parameter dependencies and constraints, if combinations of parameter values can cause ambiguous or inoperative conditions in the target device.[§] -->
<!-- [#§RM-ID 700.89] (RA-ID 61.89) <D> To parameterize the FSoE modules, a T3 tool is used, which is suitable for downloading offline generated parameter sets. [§] -->
<!-- [#§RM-ID 700.90] (RA-ID 61.90) <D> An FSoE parametering tool based on the SCTL library is provided, which generates safe binary containers with FSoE parameter data for the SiS. [§] -->
<!-- [#§RM-ID 700.11] (RD-ID 72.11) <S> The FBC prevents the user form configuring invalid FSoE networks with multiple FSoE masters or multiple hardware addresses.[§] -->
<!-- <DeviceData xmlns="x-schema:IshSafetyDeviceDataSchema.xml"> -->
<DeviceData>
	<Hash value="18f71b33f74f3032fd28107304b41c0f71cf9999483dff7d1f4f828657e333d2b43ffd290803b9c9b8d87ffe8a996db4" />
	<FileVersion major="1" minor="3" />
	<Manufacturer name="IP CAMP Limited Liability Company" identNumber="0x0000106F">
		<!-- SAFE PARAM SECTION -->
		<Device name="SIC99" identNumber="0x49500002" enableBusAddress="no" busAddress="0" minAddress="0" maxAddress="0" busSpeed="0" offsetModuleParamStream="0" dataFormat="Motorola">
			<!-- Safety Module 1 without I/O card -->
			<Module name="FSoE_M_1BYTE_IN_1BYTE_OUT" identNumber="0x00E11000" type="Safe/CPU" major="1" minor="0" paramGrouping="no" modulPlcAddress="0" minAddr="0" maxAddr="0" lenModuleParam="4" lenUserParam="4">
				<!-- Parameter, Port Dependencies -->
				<ParameterGroup name="EtherCAT_Parameters" desc="List of required EtherCAT indexes" visible="false">
					<!--EtherCAT Parameters-->
					<ParameterList>
						<Parameter name="Type" custom="baaddf70fb5d432b8bd948ef91d6f910124a6d138edae4d5f000c4610ddc8eae" unit="-" paramIdent="0x1000" type="UInt8" view="ValueDec" default="2" min="2" max="2" bitOffset="0" bitLength="8" visible="false" />
						<Parameter name="EtherCAT Format Version" custom="6d8beb709a21680a3c0644821c4112999e7cd2f343512f73475d8566808cfdd9" unit="-" paramIdent="0x1001" type="UInt16" view="ValueDec" default="256" min="256" max="256" bitOffset="8" bitLength="16" visible="false" />
						<Parameter name="EtherCAT Device Number" custom="f09f9f1c0879d83a5d293e9e5e1ec54429b8dd5cf5335cec5f5907da1321b1fa" unit="-" paramIdent="0x1005" type="UInt32" view="ValueDec" default="633" min="633" max="633" bitOffset="24" bitLength="32" visible="false" />
					</ParameterList>
				</ParameterGroup>
				<Dependencies>
					<!-- Substitutes (place to top of dependency section)-->
					<Substitute-list>
						<Substitute-type name="${device-number}" min="1" max="32" />
					</Substitute-list>
					<!-- Value Constraints Unique (unique input value) -->
					<Value-constraints-unique>
						<Parameter-unique name="Device ${device-number}: FSoE Address" type="UInt" min="1" max="65535" />
						<Parameter-unique name="Device ${device-number}: FSoE Connection ID" type="UInt" min="1" max="65535" />
						<Parameter-unique name="Device ${device-number}: FSoE PD Read Offset" type="UInt" min="0" max="65535" />
						<Parameter-unique name="Device ${device-number}: FSoE PD Write Offset" type="UInt" min="0" max="65535" />
					</Value-constraints-unique>
				</Dependencies>
			</Module>
		</Device>
	</Manufacturer>
</DeviceData>